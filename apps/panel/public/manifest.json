{
  "manifestVersion": 5,
  "id": "com.moneymoves.premiere-toolkit",
  "name": "MoneyMoves Toolkit",
  "version": "0.14.2",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "featureFlags": {
    "enableSWCSupport": true
  },
  "requiredPermissions": {
    "network": {
      "domains": ["http://127.0.0.1:43127", "http://127.0.0.1:7503"]
    },
    "localFileSystem": "fullAccess"
  },
  "icons": [
    {
      "width": 24,
      "height": 24,
      "path": "icons/plugin.png",
      "scale": [1, 2],
      "theme": ["darkest", "dark", "medium", "lightest", "light", "all"],
      "species": ["pluginList"]
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "moneymovesPanel",
      "label": {
        "default": "MoneyMoves Toolkit"
      },
      "minimumSize": {
        "width": 280,
        "height": 320
      },
      "maximumSize": {
        "width": 2000,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 360,
        "height": 760
      },
      "preferredFloatingSize": {
        "width": 400,
        "height": 760
      },
      "icon": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/panel.png",
          "scale": [1, 2],
          "theme": ["darkest", "dark", "medium"],
          "species": ["toolbar"]
        },
        {
          "width": 23,
          "height": 23,
          "path": "icons/panel.png",
          "scale": [1, 2],
          "theme": ["lightest", "light"],
          "species": ["toolbar"]
        }
      ]
    }
  ]
}

{
  "manifestVersion": 5,
  "id": "com.moneymoves.premiere-toolkit",
  "name": "MoneyMoves Toolkit",
  "version": "0.9.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "featureFlags": {
    "enableSWCSupport": true
  },
  "requiredPermissions": {
    "network": {
      "domains": ["http://127.0.0.1:43127"]
    },
    "localFileSystem": "fullAccess"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "moneymovesPanel",
      "label": {
        "default": "MoneyMoves Toolkit"
      },
      "minimumSize": {
        "width": 280,
        "height": 320
      },
      "preferredDockedSize": {
        "width": 360,
        "height": 760
      }
    },
    {
      "type": "command",
      "id": "applyThrottleIn",
      "label": {
        "default": "MoneyMoves: Throttle In"
      }
    },
    {
      "type": "command",
      "id": "applyThrottleOut",
      "label": {
        "default": "MoneyMoves: Throttle Out"
      }
    },
    {
      "type": "command",
      "id": "applyThrottleBoth",
      "label": {
        "default": "MoneyMoves: Throttle Both"
      }
    },
    {
      "type": "command",
      "id": "applyHardStutter",
      "label": {
        "default": "MoneyMoves: Hard Stutter"
      }
    },
    {
      "type": "command",
      "id": "removeFrameGate",
      "label": {
        "default": "MoneyMoves: Remove Frame Gate"
      }
    }
  ]
}

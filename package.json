{
  "name": "moneymoves-premiere-toolkit",
  "version": "0.15.2",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.11.1"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm --filter @moneymoves/contracts build && pnpm -r check && cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace",
    "test": "pnpm -r test && pnpm test:installer && cargo test --workspace",
    "test:installer": "node --test scripts/update-uxp-registry.test.mjs",
    "format": "prettier --write . && cargo fmt --all",
    "format:check": "prettier --check . && cargo fmt --all --check",
    "dev:panel": "pnpm --filter @moneymoves/panel dev",
    "dev:renderer": "pnpm --filter @moneymoves/render-service dev",
    "build:panel": "pnpm --filter @moneymoves/panel build",
    "package:panel": "./scripts/package-panel.sh",
    "package:native": "just package-native-release",
    "verify:native-release": "./scripts/install-native-release.sh --verify-only",
    "install:native-release": "./scripts/install-native-release.sh",
    "reinstall:panel": "./scripts/reinstall-panel.sh",
    "build:renderer": "pnpm --filter @moneymoves/render-service build",
    "validate:alpha-spike": "pnpm --filter @moneymoves/contracts build && pnpm --filter @moneymoves/render-service build && node scripts/generate-alpha-spike.mjs"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
